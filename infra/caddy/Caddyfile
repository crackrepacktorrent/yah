(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(same_origin_frames) {
	header X-Frame-Options "SAMEORIGIN"
}

y4h.org, www.y4h.org {
	import security_headers
	import same_origin_frames
	encode gzip

	# The public subscription form is intentionally embeddable. Limit the frame
	# exception to this unauthenticated route; all other pages remain same-origin.
	@subscription_page path /subscribe
	header @subscription_page {
		-X-Frame-Options
		Content-Security-Policy "frame-ancestors *"
	}

	@www host www.y4h.org
	redir @www https://y4h.org{uri} permanent

	# Legacy shortlinks — proxy to Shlink so y4h.org/<slug> resolves in one hop
	# Shlink handles the redirect to the destination URL and tracks the click
	@shortlink path /signup /training /campus-training /sign-in /join /whatsapp /donate
	handle @shortlink {
		reverse_proxy shlink:8080
	}

	# Umami analytics — proxied as first-party to avoid adblockers
	# Script: /t, collection endpoint: /api/t (configured via Umami env vars)
	handle /t {
		reverse_proxy umami:3000
	}
	handle /api/t {
		reverse_proxy umami:3000
	}

	reverse_proxy sveltekit:3000
}

admin.y4h.org {
	import security_headers
	import same_origin_frames
	encode gzip
	reverse_proxy yah-admin:3002
}

y4h.link {
	import security_headers
	import same_origin_frames
	encode gzip
	reverse_proxy shlink:8080
}

mail.y4h.org {
	import security_headers
	import same_origin_frames
	encode gzip

	# Expose only links generated for email recipients. The web service reaches
	# Listmonk over Docker's private network and owns subscription forms/API use.
	# In particular, do not expose /subscription/form or /api/public/* here.
	# Admin UI is accessed via SSH tunnel: ssh -L 9000:localhost:9000 deploy@vps
	@recipient_subscription path_regexp recipient_subscription ^/subscription/[^/]+/[^/]+/?$
	@recipient_content {
		path /archive
		path /archive/*
		path /archive.xml
		path /campaign/*
		path /link/*
		path /public/*
	}
	# `route` preserves this order. Without it, Caddy's directive sorter places
	# the fallback `respond` before `reverse_proxy` and every path returns 404.
	route {
		reverse_proxy @recipient_subscription listmonk:9000
		reverse_proxy @recipient_content listmonk:9000
		respond 404
	}
}

preview.y4h.org {
	import security_headers
	encode gzip

	# Draft content must never be indexed or stored by shared caches.
	header X-Robots-Tag "noindex, nofollow, noarchive"
	header Cache-Control "private, no-store"
	respond /robots.txt "User-agent: *\nDisallow: /\n" 200

	# Allow Storyblok Visual Editor to embed this site in an iframe
	header Content-Security-Policy "frame-ancestors https://app.storyblok.com"

	reverse_proxy sveltekit-preview:3001
}
