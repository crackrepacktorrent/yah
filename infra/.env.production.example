# ============================================
# STORYBLOK AND PUBLIC WEB BUILD
# ============================================

# Build-time public token. The deploy workflow reads this value from GitHub
# Actions secrets rather than this file.
VITE_STORYBLOK_PUBLIC_TOKEN=
VITE_SITE_URL=https://y4h.org
VITE_UMAMI_URL=https://y4h.org
VITE_UMAMI_WEBSITE_ID=

# The private runtime STORYBLOK_PUBLIC_TOKEN and STORYBLOK_PREVIEW_TOKEN(S)
# belong in apps/web/.env.production and apps/web/.env.preview. See the web
# app's .env.production.example; never pass a preview token into a web build.

# ============================================
# DATABASE PASSWORDS (generate unique for each)
# ============================================

POSTGRES_ROOT_PASSWORD=
SHLINK_DB_PASSWORD=
UMAMI_DB_PASSWORD=
YAH_DB_PASSWORD=
LISTMONK_DB_PASSWORD=

# ============================================
# UMAMI
# ============================================

UMAMI_APP_SECRET=

# ============================================
# SHLINK
# ============================================

SHLINK_API_KEY=
GEOLITE_LICENSE_KEY=
