# ============================================
# STORYBLOK CONFIGURATION
# ============================================

# Storyblok Access Token
# Get tokens from: Storyblok Settings > Access Tokens
# - Production: Use "Public" token (only published content)
# - Preview: Use "Preview" token (draft + published content)
# - Local dev: Use "Preview" token
VITE_STORYBLOK_TOKEN=your_token_here

# Storyblok Preview Mode
# Set to 'true' to enable preview/draft mode
# VITE_STORYBLOK_IS_PREVIEW=true

# ============================================
# SITE CONFIGURATION
# ============================================

VITE_SITE_URL=https://y4h.org

# ============================================
# AUTH (Better Auth)
# ============================================

BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:5173

# ============================================
# DATABASE
# ============================================

DATABASE_URL=postgres://yah:password@localhost:5432/yah

# ============================================
# UMAMI (analytics)
# ============================================

# Client-side tracking snippet (leave blank to disable)
VITE_UMAMI_URL=http://localhost:3001
VITE_UMAMI_WEBSITE_ID=

# Server-side API for admin dashboard
UMAMI_URL=http://localhost:3001
UMAMI_USERNAME=admin
UMAMI_PASSWORD=umami
UMAMI_WEBSITE_ID=

# ============================================
# SHLINK (shortlink management)
# ============================================

SHLINK_API_KEY=your-shlink-api-key
SHLINK_URL=http://localhost:8080

# ============================================
# SERVER (adapter-node, production only)
# ============================================

# PORT=3000
# ORIGIN=https://y4h.org
# PROTOCOL_HEADER=X-Forwarded-Proto
# HOST_HEADER=X-Forwarded-Host
