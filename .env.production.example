# ============================================
# STORYBLOK
# ============================================

VITE_STORYBLOK_TOKEN=<public-token>
VITE_SITE_URL=https://y4h.org

# ============================================
# DATABASE PASSWORDS (generate unique for each)
# ============================================

POSTGRES_ROOT_PASSWORD=<generate>
SHLINK_DB_PASSWORD=<generate>
UMAMI_DB_PASSWORD=<generate>
YAH_DB_PASSWORD=<generate>

# ============================================
# BETTER AUTH
# ============================================

BETTER_AUTH_SECRET=<generate>
BETTER_AUTH_URL=https://y4h.org
DATABASE_URL=postgres://yah:${YAH_DB_PASSWORD}@postgres:5432/yah

# ============================================
# LISTMONK
# ============================================

LISTMONK_URL=http://listmonk:9000
LISTMONK_USERNAME=admin
LISTMONK_PASSWORD=<change-from-default>
LISTMONK_DB_PASSWORD=<generate>
LISTMONK_INVITATION_TEMPLATE_ID=<from-listmonk-admin>

# ============================================
# SHLINK
# ============================================

SHLINK_API_KEY=<generate-uuid>
SHLINK_URL=http://shlink:8080
GEOLITE_LICENSE_KEY=<optional-maxmind-key>

# ============================================
# UMAMI
# ============================================

UMAMI_APP_SECRET=<generate>
VITE_UMAMI_URL=https://y4h.org
VITE_UMAMI_WEBSITE_ID=<from-umami-dashboard>
UMAMI_URL=http://umami:3000
UMAMI_USERNAME=admin
UMAMI_PASSWORD=<change-from-default>
UMAMI_WEBSITE_ID=<from-umami-dashboard>
