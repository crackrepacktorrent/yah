# ============================================
# BETTER AUTH
# Same values as yah's .env.production
# ============================================

# Deliberately invalid placeholder: startup rejects it until replaced.
# Solid 2 admin runtime mode
ADMIN_RUNTIME=production

BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=https://admin.y4h.org
PUBLIC_SITE_URL=https://y4h.org
DATABASE_URL=postgres://yah:<YAH_DB_PASSWORD>@postgres:5432/yah

# ============================================
# LISTMONK
# Same values as yah's .env.production
# ============================================

LISTMONK_URL=http://listmonk:9000
LISTMONK_API_TOKEN=<same as yah>
LISTMONK_ADMIN_ACCESS_TEMPLATE_ID=<provisioned transactional template ID>
LISTMONK_INVITATION_TEMPLATE_ID=<same as yah>
LISTMONK_PASSWORD_RESET_TEMPLATE_ID=<same as yah>

# ============================================
# SHLINK
# Same values as yah's .env.production
# ============================================

SHLINK_API_KEY=<same as yah>
SHLINK_URL=http://shlink:8080

# ============================================
# UMAMI
# Same values as yah's .env.production
# ============================================

UMAMI_URL=http://umami:3000
UMAMI_USERNAME=<same as yah>
UMAMI_PASSWORD=<same as yah>
UMAMI_WEBSITE_ID=<same as yah>
