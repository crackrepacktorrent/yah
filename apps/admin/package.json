		"nitro": "^3.0.260311-beta",
		"pg": "^8.20.0",
		"p-limit": "^7.3.1",
		"qr-code-styling": "^1.9.2",
		"solid-js": "^1.9.12",
		"solid-sonner": "^0.3.1",
