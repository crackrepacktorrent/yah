{
	"name": "yah-admin",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"start": "srvx --prod --entry server.mjs",
		"preview": "vite preview",
		"check": "tsc --noEmit",
		"lint": "oxlint -c oxlint.config.mjs src e2e vite.config.ts playwright.config.ts playwright.production.config.ts env.ts server.mjs",
		"test": "vitest run",
		"ops:audit-auth": "bun scripts/audit-auth.ts",
		"ops:bootstrap-admin": "bun scripts/bootstrap-admin.ts",
		"ops:verify-existing-owners": "bun scripts/verify-existing-owners.ts",
		"test:auth-integration": "vitest run src/platform/auth/production-auth.integration.test.ts",
		"test:listmonk-integration": "vitest run src/integrations/listmonk/*.integration.test.ts",
		"install:e2e": "playwright install --with-deps chromium",
		"test:e2e": "env ADMIN_RUNTIME=platform-disabled bun run build && playwright test",
		"test:e2e:production": "env ADMIN_RUNTIME=production bun run build && playwright test --config playwright.production.config.ts"
	},
	"dependencies": {
		"@fontsource-variable/rubik": "5.3.0",
		"@yah/admin-core": "workspace:*",
		"@lexical/html": "0.51.0",
		"@lexical/link": "0.51.0",
		"@lexical/list": "0.51.0",
		"@lexical/rich-text": "0.51.0",
		"@lexical/selection": "0.51.0",
		"@solidjs/router": "2.0.0-next.30",
		"@solidjs/web": "2.0.0-rc.9",
		"better-auth": "1.6.33",
		"lexical": "0.51.0",
		"lucide": "1.48.0",
		"pg": "8.23.0",
		"qr-code-styling": "1.9.2",
		"solid-js": "2.0.0-rc.9",
		"srvx": "1.0.5",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "^1.63.0",
		"@solidjs/vite-plugin": "3.0.0-next.44",
		"@types/node": "^22.20.4",
		"@types/pg": "^8.23.1",
		"eslint-plugin-solid": "~0.18.0",
		"filesystem-routing": "0.4.0",
		"jsdom": "^28.1.0",
		"oxlint": "~1.85.0",
		"playwright-core": "^1.63.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	}
}
