{
	"name": "yah-admin",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite start",
		"preview": "vite preview",
		"lint": "eslint src scripts e2e playwright.config.ts --ext .ts,.tsx",
		"lint:fix": "eslint src scripts e2e playwright.config.ts --ext .ts,.tsx --fix",
		"format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
		"test": "bun test src tests",
		"test:e2e": "playwright test",
		"test:e2e:current": "playwright test --project=current",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:v2": "playwright test --project=v2",
		"check": "tsc --noEmit",
		"check:e2e": "tsc -p tsconfig.e2e.json --noEmit",
		"type-check": "tsc --noEmit",
		"ops:audit-auth": "bun scripts/audit-auth.ts",
