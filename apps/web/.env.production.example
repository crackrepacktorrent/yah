# ============================================
# STORYBLOK (private runtime values)
# ============================================

# Optional runtime override for the build-time public delivery token.
# STORYBLOK_PUBLIC_TOKEN=

# Preview token used only to verify signed Visual Editor requests and fetch
# drafts for those requests. Prefer the plural variable during token rotation.
STORYBLOK_PREVIEW_TOKEN=
# STORYBLOK_PREVIEW_TOKENS=current_token,next_token
# Deprecated runtime-only migration fallback: VITE_STORYBLOK_PREVIEW_TOKEN=

# ============================================
# LISTMONK (required for the /subscribe route)
# ============================================

LISTMONK_URL=http://listmonk:9000

# ============================================
# STORYBLOK WEBHOOK
# ============================================

STORYBLOK_WEBHOOK_SECRET=

# Optional missed-webhook fallback; defaults to four hours (minimum 1 minute).
# STORYBLOK_CACHE_REFRESH_MS=14400000

# ============================================
# CLOUDFLARE (optional — cache purge on publish)
# ============================================

CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
