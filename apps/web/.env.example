# ============================================
# STORYBLOK CONFIGURATION
# ============================================

# Storyblok access tokens
# Get tokens from: Storyblok Settings > Access Tokens
# The public token is safe to expose and is compiled into the client bundle.
VITE_STORYBLOK_PUBLIC_TOKEN=your_public_token_here

# Optional runtime override for server-side published requests.
STORYBLOK_PUBLIC_TOKEN=your_public_token_here

# Server-only preview tokens. Never prefix a preview token with VITE_.
# STORYBLOK_PREVIEW_TOKENS can contain comma-separated tokens during rotation;
# it takes precedence over STORYBLOK_PREVIEW_TOKEN when set.
STORYBLOK_PREVIEW_TOKEN=your_preview_token_here
# STORYBLOK_PREVIEW_TOKENS=your_current_preview_token,your_next_preview_token
# VITE_STORYBLOK_PREVIEW_TOKEN is accepted only as a deprecated server-runtime
# migration fallback. Never pass it as a Docker build argument or read it from
# client code.

# Storyblok Preview Mode
# Set to 'true' to load the Visual Editor bridge. Draft content is still only
# returned for requests carrying a valid Storyblok editor signature.
# VITE_STORYBLOK_IS_PREVIEW=true

# ============================================
# SITE CONFIGURATION
# ============================================

VITE_SITE_URL=https://y4h.org

# ============================================
# UMAMI (analytics)
# ============================================

# Client-side tracking snippet (leave blank to disable)
VITE_UMAMI_URL=http://localhost:3001
VITE_UMAMI_WEBSITE_ID=

# ============================================
# LISTMONK (public subscription only — no auth needed)
# ============================================

LISTMONK_URL=http://localhost:9000

# ============================================
# SHLINK (only needed by scripts/migrate-shortlinks.sh)
# ============================================

SHLINK_API_KEY=your-shlink-api-key
SHLINK_URL=http://localhost:8080

# ============================================
# STORYBLOK WEBHOOK (cache invalidation)
# ============================================

# Secret to verify webhook requests from Storyblok
# Set in Storyblok: Settings > Webhooks > Secret
STORYBLOK_WEBHOOK_SECRET=your-webhook-secret-here

# Safety refresh for the published in-process response cache. Storyblok publish
# webhooks invalidate immediately; this bounds stale origin data if one is missed.
# The four-hour default matches the public Cloudflare edge TTL.
# STORYBLOK_CACHE_REFRESH_MS=14400000

# ============================================
# CLOUDFLARE (cache purging)
# ============================================

# API token with Cache Purge permission, scoped to your zone
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id

# ============================================
# SERVER (adapter-node, production only)
# ============================================

# PORT=3000
# ORIGIN=https://y4h.org
# PROTOCOL_HEADER=X-Forwarded-Proto
# HOST_HEADER=X-Forwarded-Host
