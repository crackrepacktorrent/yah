(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

y4h.org, www.y4h.org {
	import security_headers
	encode gzip

	@www host www.y4h.org
	redir @www https://y4h.org{uri} permanent

	# Legacy shortlinks — proxy to Shlink so y4h.org/<slug> resolves in one hop
	# Shlink handles the redirect to the destination URL and tracks the click
	@shortlink path /signup /training /campus-training /sign-in /join /whatsapp /donate
	handle @shortlink {
		reverse_proxy shlink:8080
	}

	# Umami analytics — proxied as first-party to avoid adblockers
	# Script: /t, collection endpoint: /api/t (configured via Umami env vars)
	handle /t {
		reverse_proxy umami:3000
	}
	handle /api/t {
		reverse_proxy umami:3000
	}

	# Admin, API, and subscribe routes: never cache
	handle /admin/* {
		header Cache-Control "private, no-store"
		reverse_proxy sveltekit:3000
	}
	handle /api/* {
		header Cache-Control "private, no-store"
		reverse_proxy sveltekit:3000
	}
	handle /subscribe* {
		header Cache-Control "private, no-store"
		reverse_proxy sveltekit:3000
	}

	# Public pages: cache at edge (s-maxage) for 4 hours, browser revalidates after 60s
	# Storyblok webhook purges both caches on content publish
	handle {
		header Cache-Control "public, s-maxage=14400, max-age=60, stale-while-revalidate=60"
		reverse_proxy sveltekit:3000
	}
}

y4h.link {
	import security_headers
	encode gzip
	reverse_proxy shlink:8080
}

mail.y4h.org {
	import security_headers
	encode gzip

	# Only expose Listmonk's public pages (subscription, unsubscribe, archive)
	# Admin UI is accessed via SSH tunnel: ssh -L 9000:localhost:9000 deploy@vps
	@public {
		path /subscription/*
		path /public/*
		path /api/public/*
	}
	reverse_proxy @public listmonk:9000

	# Block everything else
	respond 404
}

preview.y4h.org {
	import security_headers
	encode gzip

	# Allow Storyblok Visual Editor to embed this site in an iframe
	# frame-ancestors supersedes X-Frame-Options in modern browsers
	header -X-Frame-Options
	header Content-Security-Policy "frame-ancestors https://app.storyblok.com"

	reverse_proxy sveltekit-preview:3001
}
