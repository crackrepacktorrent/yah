(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

y4h.org, www.y4h.org {
	import security_headers
	encode gzip

	@www host www.y4h.org
	redir @www https://y4h.org{uri} permanent

	# Legacy shortlink redirects — preserves existing QR codes printed as y4h.org/<slug>
	redir /signup          https://y4h.link/signup permanent
	redir /training        https://y4h.link/training permanent
	redir /campus-training https://y4h.link/campus-training permanent
	redir /sign-in         https://y4h.link/sign-in permanent
	redir /join            https://y4h.link/join permanent
	redir /whatsapp        https://y4h.link/whatsapp permanent
	redir /donate          https://y4h.link/donate permanent

	reverse_proxy sveltekit:3000
}

y4h.link {
	import security_headers
	encode gzip
	reverse_proxy shlink:8080
}

analytics.y4h.org {
	import security_headers
	encode gzip
	header X-Frame-Options "SAMEORIGIN"
	reverse_proxy umami:3000
}

mail.y4h.org {
	import security_headers
	encode gzip

	# Only expose Listmonk's public pages (subscription, unsubscribe, archive)
	# Admin UI is accessed via SSH tunnel: ssh -L 9000:localhost:9000 deploy@vps
	@public {
		path /subscription/*
		path /public/*
		path /api/public/*
	}
	reverse_proxy @public listmonk:9000

	# Block everything else
	respond 404
}

preview.y4h.org {
	import security_headers
	encode gzip
	reverse_proxy sveltekit-preview:3001
}
