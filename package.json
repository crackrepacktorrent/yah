{
  "name": "yah",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo build",
    "check": "turbo check",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e:admin-v2": "bun run --cwd apps/admin-v2 test:e2e",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:admin-v2": "bun run --cwd apps/admin-v2 dev"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
